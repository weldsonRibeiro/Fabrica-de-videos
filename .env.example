# Copie para .env e exporte (ex.: `set -a; source .env; set +a`). NUNCA commite o .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcionais (valores padrão)
# FABRICA_MODELO=claude-opus-5-5     # ex.: claude-sonnet-5-5 para gastar menos
# FABRICA_ESFORCO=medium             # low | medium | high | xhigh | max
# FABRICA_SEM_FALLBACK=1             # desliga o fallback server-side do Claude
# FABRICA_CENAS=12
# FABRICA_VOZ=onyx
# FABRICA_MODELO_VOZ=gpt-4o-mini-tts
# FABRICA_MODELO_IMAGEM=gpt-image-1
# FABRICA_QUALIDADE_IMAGEM=medium
# FABRICA_SAIDA=saida
# FABRICA_COTACAO=1.0                # custos são estimados em USD; use ~5.5 para contar em R$
