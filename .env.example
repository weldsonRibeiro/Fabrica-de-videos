# Copie para .env e exporte (ex.: `set -a; source .env; set +a`). NUNCA commite o .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcionais (valores padrão)
# FABRICA_MODELO=claude-opus-5-5     # ex.: claude-sonnet-5-5 para gastar menos
# FABRICA_ESFORCO=medium             # low | medium | high | xhigh | max
# FABRICA_SEM_FALLBACK=1             # desliga o fallback server-side do Claude
# FABRICA_CENAS=12
# FABRICA_VOZ=onyx
# FABRICA_MODELO_VOZ=gpt-4o-mini-tts
# FABRICA_MODELO_IMAGEM=gpt-image-1
# FABRICA_QUALIDADE_IMAGEM=medium
# FABRICA_SAIDA=saida
# FABRICA_COTACAO=1.0                # custos são estimados em USD; use ~5.5 para contar em R$

# --- YouTube (publicação) ---
# Crie um projeto no Google Cloud, ative a "YouTube Data API v3" e crie credenciais OAuth do tipo "App para computador".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Um token por canal do YouTube (id do canal em canais.json, em maiúsculas; "-" vira "_").
# Gere com: python -m fabrica youtube-autorizar --canal historias
# YOUTUBE_REFRESH_TOKEN_HISTORIAS=
# FABRICA_FUSO=America/Sao_Paulo        # fuso dos horários que você aprova
# YOUTUBE_CATEGORIA=22                  # 27 = Educação, 28 = Ciência e tecnologia...
# FABRICA_INTERVALO_SHORTS_H=12         # cada short sai N horas depois do anterior
# FABRICA_SEM_SELO_IA=1                 # NÃO recomendado: tira a declaração de conteúdo sintético

# --- Painel de aprovação (celular) ---
# Gere uma chave: python -c "import secrets; print(secrets.token_urlsafe(32))"
FABRICA_PAINEL_CHAVE=
